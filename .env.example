# Copy file này thành ".env" (cùng thư mục Dockerfile) rồi điền key thật vào.
# KHÔNG commit file ".env" thật lên Git — chỉ commit ".env.example" này.

# Lấy miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tuỳ chọn — chỉ cần nếu muốn dùng model GPT-4o / GPT-4o mini để dự phòng khi Gemini hết quota.
# Lấy tại: https://platform.openai.com/api-keys (trả phí theo lượng dùng)
OPENAI_API_KEY=

TAVILY_API_KEY= 

# Tuỳ chọn — chỉ cần nếu muốn dùng model Grok (xAI) để dự phòng khi các model khác hết quota.
# Lấy tại: https://console.x.ai (trả phí theo lượng dùng, cần nạp credit trước)
XAI_API_KEY=

# Tuỳ chọn — Groq (KHÁC với Grok/xAI ở trên) chạy các model mã nguồn mở (GPT-OSS...) trên
# hạ tầng siêu nhanh, có gói MIỄN PHÍ hào phóng (~14,400 request/ngày).
# Lấy tại: https://console.groq.com/keys
GROQ_API_KEY=

OPENROUTER_API_KEY= 
#Carto API key — dùng để hiển thị bản đồ trong web app. 
CARTO_API_KEY=key_bạn_nhận_được
# Chuỗi bí mật để ký cookie session Flask — đặt 1 chuỗi ngẫu nhiên bất kỳ, giữ cố định
# để session không bị reset mỗi lần container restart.
FLASK_SECRET_KEY=


# Model Router: chỉ backend sử dụng; không hiển thị model đã chọn trong giao diện chat.
# Để trống FAST/REASONING_MODEL để router tự chọn theo thứ tự ưu tiên trong src/model_router.py.
MODEL_ROUTER_FAST_MODEL=
MODEL_ROUTER_REASONING_MODEL=
MODEL_ROUTER_MAX_ATTEMPTS=8

# RAG: Docker Compose uses the qdrant service; native Python defaults to local persistent storage.
QDRANT_URL=http://qdrant:6333
QDRANT_LOCAL_PATH=.qdrant_storage
RAG_COLLECTION_NAME=logistics_knowledge
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DEVICE=cpu
RAG_MIN_RELEVANCE_SCORE=0.20
# auto chooses the first configured provider; optionally: gemini, groq, openrouter, openai, xai
RAG_LLM_PROVIDER=auto
# Optional model override for RAG only. Leave empty to use the provider default.
RAG_LLM_MODEL=
